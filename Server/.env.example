# Server-side PayGlocal UAT configuration. Keep this file as a template only.
MONGODB_URI=mongodb://127.0.0.1:27017/seafood
CLIENT_URL=https://your-website.example
PAYGLOCAL_ENV=uat
PAYGLOCAL_MERCHANT_ID=your_uat_mid
PAYGLOCAL_PRIVATE_KEY_ID=your_uat_private_key_id
# PayGlocal encryption public key and its KID from GCC, used by the official client to create the initiate JWE.
PAYGLOCAL_PUBLIC_KEY_ID=your_payglocal_public_key_id
PAYGLOCAL_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_PAYGLOCAL_PUBLIC_KEY\n-----END PUBLIC KEY-----
# Paste PEM contents here and escape line breaks as \n, or set it through your secrets manager.
PAYGLOCAL_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----
# Set only if the downloaded RSA private key is encrypted; keep blank otherwise.
PAYGLOCAL_PRIVATE_KEY_PASSPHRASE=
# PayGlocal signing certificate used to validate signed callback tokens.
PAYGLOCAL_PUBLIC_CERT=-----BEGIN CERTIFICATE-----\nREPLACE_WITH_PAYGLOCAL_CERTIFICATE\n-----END CERTIFICATE-----
# Public callback URL, must map to POST /api/payments/callback and be publicly reachable over HTTPS.
PAYGLOCAL_CALLBACK_URL=https://your-website.example/api/payments/callback
