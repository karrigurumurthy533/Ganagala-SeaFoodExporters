# Leave as /api/payments/orders to use the Vite /api proxy during local dev.
VITE_PAYMENTS_API_URL=/api/payments/orders
# Local backend URL used by Vite dev server proxy (defaults to http://localhost:5000).
VITE_API_PROXY_TARGET=http://localhost:5000
# Must match CASHFREE_ENV on the server ("sandbox" or "production").
VITE_CASHFREE_ENV=sandbox
# Cashfree JS SDK v3 URL loaded in the browser.
VITE_CASHFREE_SDK_URL=https://sdk.cashfree.com/js/v3/cashfree.js
